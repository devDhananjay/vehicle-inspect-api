# Active provider: carinfo-public | carinfo-authorized | licensed | fallback
VEHICLE_PROVIDER=carinfo-public

PORT=3010
HOST=0.0.0.0
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_RETRIES=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# -----------------------------------------------------------------------------
# CarInfo authorized / Business API (official docs only — never commit secrets)
# -----------------------------------------------------------------------------
CARINFO_API_BASE_URL=https://api.example-carinfo.invalid
CARINFO_VEHICLE_ENDPOINT=
CARINFO_REQUEST_METHOD=GET
CARINFO_RC_PARAM=registrationNumber
CARINFO_API_KEY=
CARINFO_CLIENT_ID=
CARINFO_CLIENT_SECRET=
CARINFO_ACCESS_TOKEN=
# Only if official docs provide an OAuth token URL:
CARINFO_TOKEN_URL=
CARINFO_AUTH_HEADER=Authorization
CARINFO_AUTH_SCHEME=Bearer

# -----------------------------------------------------------------------------
# Generic licensed provider (alternate vendor)
# -----------------------------------------------------------------------------
LICENSED_PROVIDER_BASE_URL=
LICENSED_PROVIDER_API_KEY=
LICENSED_PROVIDER_REQUEST_PATH=
LICENSED_PROVIDER_HTTP_METHOD=GET
LICENSED_PROVIDER_RC_PARAM=registrationNumber
LICENSED_PROVIDER_AUTH_HEADER=Authorization
LICENSED_PROVIDER_AUTH_SCHEME=Bearer
